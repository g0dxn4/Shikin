{
  "name": "@shikin/cli",
  "version": "1.0.10",
  "packageManager": "pnpm@11.1.1",
  "description": "Shikin CLI and MCP server for local finance automation",
  "type": "module",
  "bin": {
    "shikin-bridge": "./dist/cli.js",
    "shikin-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "prebuild": "pnpm --dir .. build && node ../scripts/copy-web-to-cli.mjs",
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^13.1.0",
    "dayjs": "^1.11.13",
    "ulidx": "^2.4.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@shikin/finance-core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
