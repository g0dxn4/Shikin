{
  "name": "@shikin/finance-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./corrections": {
      "types": "./dist/corrections.d.ts",
      "import": "./dist/corrections.js",
      "default": "./dist/corrections.js"
    },
    "./imports": {
      "types": "./dist/imports.d.ts",
      "import": "./dist/imports.js",
      "default": "./dist/imports.js"
    },
    "./payments": {
      "types": "./dist/payments.d.ts",
      "import": "./dist/payments.js",
      "default": "./dist/payments.js"
    },
    "./reconciliation": {
      "types": "./dist/reconciliation.d.ts",
      "import": "./dist/reconciliation.js",
      "default": "./dist/reconciliation.js"
    },
    "./valuation": {
      "types": "./dist/valuation.d.ts",
      "import": "./dist/valuation.js",
      "default": "./dist/valuation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/finance-core/src"
  }
}
